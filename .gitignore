# Never commit tunnel configs, WARP accounts, exports, sing-box profiles or the
# Nord token: they hold private keys (a store kept inside the repo, say)
*.conf
*.zip
*.toml
!pyproject.toml
sing-box/
.nord-token
.DS_Store

# The test and lint tools (test.sh makes it)
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test fixtures: fake keys only
!tests/golden/**/*.conf
!tests/golden/**/sing-box/
